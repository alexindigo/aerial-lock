IQ7aunMZT7XZNn/Bh1XZp5m5MkL72NVxnn6hUrcbvZNCJBIqxw8dtk2cXmPIS4AX
UKqK1drk/NAJBzewdXUh
-----END CERTIFICATE-----
EOF

# Manifest: fetch tar, extract entries.json, validate, atomically replace.
if ! curl --fail -sS --cacert "$TMP/apple-root.pem" \
        -o "$TMP/resources.tar" "$MANIFEST_URL"; then
    echo "aerial-lock-fetch: manifest fetch failed: $MANIFEST_URL" >&2
    exit 1
fi
if ! tar -xOf "$TMP/resources.tar" entries.json > "$TMP/entries.json" \
        || [ ! -s "$TMP/entries.json" ]; then
    echo "aerial-lock-fetch: manifest tar has no entries.json" >&2
    exit 1
fi
if ! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$TMP/entries.json"; then
    echo "aerial-lock-fetch: entries.json is not valid JSON" >&2
    exit 1
fi
mv -f "$TMP/entries.json" "$CACHE/entries.json.tmp"
mv -f "$CACHE/entries.json.tmp" "$CACHE/entries.json"

# Asset list: "id<TAB>url-1080-H264" per line. All 114 assets carry the
# 1080p H.264 field (verified against resources-16.tar, 2026-09).
python3 - "$CACHE/entries.json" "$LIMIT" > "$TMP/wanted.tsv" <<'EOF'
import json, sys
data = json.load(open(sys.argv[1]))
limit = int(sys.argv[2])
assets = data.get("assets", [])
if limit > 0:
    assets = assets[:limit]
for a in assets:
    aid, url = a.get("id"), a.get("url-1080-H264")
    if aid and url:
        print(aid + "\t" + url)
EOF

# Clips: skip what's cached, resume partials (-C -), warn and continue on
# individual failures. A truncated clip is not "cached": a .mov cut short
# loses its moov atom and won't play. Completion is tracked by a
# <id>.mp4.done marker written only after curl exits 0; a clip without the
# marker is (re)fetched, and -C - resumes it. (If the marker is lost but
# the clip is complete, curl -C - is a cheap no-op and the marker is
# re-touched.)
TAB="$(printf '\t')"
while IFS="$TAB" read -r id url; do
    [ -n "$id" ] || continue
    out="$VIDEOS/$id.mp4"
    if [ -s "$out" ] && [ -f "$out.done" ]; then
        echo "aerial-lock-fetch: have $id — skipped"
        continue
    fi
    echo "aerial-lock-fetch: fetching $id"
    if curl --fail -sS --cacert "$TMP/apple-root.pem" \
            -C - -o "$out" "$url"; then
        touch "$out.done"
    else
        rm -f "$out.done"
        echo "aerial-lock-fetch: clip $id failed — continuing" >&2
    fi
done < "$TMP/wanted.tsv"

# Success = at least one clip in the cache when done (cached counts).
set -- "$VIDEOS"/*.mp4
if [ -e "$1" ]; then
    echo "aerial-lock-fetch: $# clip(s) in $VIDEOS"
    exit 0
fi
echo "aerial-lock-fetch: no clips in $VIDEOS" >&2
exit 1
