-----END CERTIFICATE-----
EOF

# fetch_url <url> <dest> [extra curl args...] — on curl exit 60 (issuer not
# trusted) retry once with the pinned Apple Root CA. -L: community clip
# URLs are github release assets, which 302 to a CDN (d37).
fetch_url() {
    _fu_url="$1"; _fu_dest="$2"; shift 2
    _fu_rc=0
    curl --fail -sS --location "$@" -o "$_fu_dest" -- "$_fu_url" || _fu_rc=$?
    if [ "$_fu_rc" -eq 60 ]; then
        echo "aerial-lock-fetch: system trust failed for $_fu_url — retrying with pinned Apple Root CA" >&2
        _fu_rc=0
        curl --fail -sS --location --cacert "$PEM" "$@" -o "$_fu_dest" -- "$_fu_url" || _fu_rc=$?
    fi
    return "$_fu_rc"
}

# Validated remote sources from the user config:
# "safe-name<TAB>type<TAB>url<TAB>min<TAB>max" (min/max empty = unbounded).
# Same per-field tolerance as the locker (bad entry → WARN naming the index,
# rest kept); name sanitize/dedupe rule matches SourceCache.qml.
#
# preferredResolution handling (d37): if the key is absent from the user
# file and a compositor probe can see outputs, the largest connected
# output's logical height decides (>= 2160 → 2160, else 1080) and the key
# is written into the user file (atomic rewrite, other keys untouched). A
# key already in the file — valid or not — is never touched. No key and no
# probe → this run picks the highest in-band URL without writing anything.
if [ ! -f "$CONFIG" ]; then
    echo "aerial-lock-fetch: no config at $CONFIG — no remote sources" >&2
    exit 1
fi
python3 - "$CONFIG" "$TMP/sources.tsv" "$TMP/preferred" <<'PYEOF'
import json, os, re, subprocess, sys

config_path, sources_out, preferred_out = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    data = json.load(open(config_path))
except Exception as e:
    sys.stderr.write(f"aerial-lock-fetch: cannot parse {config_path}: {e}\n")
    sys.exit(3)

def probe_logical_height():
    """Largest connected output's logical height, or None if nobody can see
    outputs. Same env detection as the locker's Compositor.qml."""
    if os.environ.get("NIRI_SOCKET"):
        try:
            out = subprocess.run(["niri", "msg", "-j", "outputs"],
                                 capture_output=True, timeout=5)
            hs = [o["logical"]["height"] for o in json.loads(out.stdout).values()
                  if isinstance(o.get("logical"), dict)
                  and isinstance(o["logical"].get("height"), (int, float))]
            return max(hs) if hs else None
        except Exception:
            return None
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        try:
            out = subprocess.run(["hyprctl", "monitors", "-j"],
                                 capture_output=True, timeout=5)
            hs = [round(m["height"] / m["scale"]) for m in json.loads(out.stdout)
                  if isinstance(m.get("height"), (int, float))
                  and isinstance(m.get("scale"), (int, float)) and m["scale"]]
            return max(hs) if hs else None
        except Exception:
            return None
    return None

# Existence-write: only when the key is ABSENT. A present key is never
# touched — even one sanitise would reject (e.g. 1440); it is the user's.
if "preferredResolution" not in data:
    h = probe_logical_height()
    if h:
        data["preferredResolution"] = 2160 if h >= 2160 else 1080
        tmp = config_path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        os.replace(tmp, config_path)
        sys.stderr.write(f"aerial-lock-fetch: wrote preferredResolution {data['preferredResolution']} "
                         f"(largest output {h}p) into {config_path}\n")

preferred = data.get("preferredResolution")
if preferred is not None:
    if isinstance(preferred, int) and preferred in (1080, 2160):
        open(preferred_out, "w").write(str(preferred))
    else:
        sys.stderr.write(f"aerial-lock-fetch: preferredResolution {preferred!r} is not 1080 or 2160 — ignoring it\n")

sources = data.get("sources", [])
if not isinstance(sources, list):
    sys.stderr.write("aerial-lock-fetch: config 'sources' is not a list\n")
    sys.exit(3)
lines = []
seen = set()
for i, s in enumerate(sources):
    if not isinstance(s, dict) or not all(isinstance(s.get(k), str) and s.get(k) for k in ("type", "name", "source")):
        sys.stderr.write(f"aerial-lock-fetch: sources[{i}] needs type/name/source strings — skipped\n")
        continue
    if s["type"] not in ("apple", "community", "folder", "file"):
        sys.stderr.write(f"aerial-lock-fetch: sources[{i}].type {s['type']!r} unknown — skipped\n")
        continue
    if s["type"] in ("folder", "file"):
        continue
    band = []
    bad = False
    for k in ("minResolution", "maxResolution"):
        v = s.get(k)
        if v is None:
            # "-" for unbounded: tab is IFS-whitespace to the shell's read,
            # so an empty field would collapse and shift the columns.
            band.append("-")
        elif isinstance(v, int) and v in (1080, 2160):
            band.append(str(v))
        else:
            sys.stderr.write(f"aerial-lock-fetch: sources[{i}].{k} {v!r} is not 1080 or 2160 — source skipped\n")
            bad = True
    if bad:
        continue
    safe = re.sub(r"[^A-Za-z0-9._-]", "", s["name"].replace(" ", "-"))
    if not safe:
        sys.stderr.write(f"aerial-lock-fetch: sources[{i}].name sanitizes to nothing — skipped\n")
        continue
    if safe in seen:
        sys.stderr.write(f"aerial-lock-fetch: duplicate source name {safe!r} — skipping later entry\n")
        continue
    seen.add(safe)
    lines.append("\t".join((safe, s["type"], s["source"], band[0], band[1])))
with open(sources_out, "w") as f:
    f.write("\n".join(lines) + ("\n" if lines else ""))
PYEOF

if [ ! -s "$TMP/sources.tsv" ]; then
    echo "aerial-lock-fetch: no remote sources in config" >&2
    exit 1
fi

# classify <file> → prints "entries" (bare VideoManifest), "wrapper <url>",
# or "unknown".
classify() {
    python3 - "$1" <<'PYEOF'
import json, sys
raw = open(sys.argv[1], "rb").read()
if raw[257:262] == b"ustar":
    print("tar"); sys.exit(0)
try:
    d = json.loads(raw)
except Exception:
    print("unknown"); sys.exit(0)
if isinstance(d, dict) and isinstance(d.get("assets"), list):
    print("entries")
elif isinstance(d, dict) and isinstance(d.get("manifestUrl"), str) and d["manifestUrl"]:
    print("wrapper " + d["manifestUrl"])
else:
    print("unknown")
PYEOF
}

# install_entries <src-file> <cache-dir> — validate + atomic replace.
install_entries() {
    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert isinstance(d.get("assets"), list)' "$1" 2>/dev/null || {
        echo "aerial-lock-fetch: entries.json is not a valid manifest" >&2
        return 1
    }
    mkdir -p -- "$2"
    cp -- "$1" "$2/entries.json.tmp"
    mv -f -- "$2/entries.json.tmp" "$2/entries.json"
}

# fetch_one <safe-name> <url> <min> <max> — resolve the manifest body
# (tar / wrapper / bare JSON), install the sentinel, download clips picked
# from the resolution band + preferredResolution. Returns 0 if the cache
# holds at least one clip when done.
fetch_one() {
    _fo_name="$1"; _fo_url="$2"; _fo_min="$3"; _fo_max="$4"
    [ "$_fo_min" = "-" ] && _fo_min=""
    [ "$_fo_max" = "-" ] && _fo_max=""
    _fo_cache="$CACHE_BASE/$_fo_name"
    _fo_body="$TMP/$_fo_name.body"

    case "$_fo_url" in
        *.tar|*.json) _fo_first="$_fo_url" ;;
        *)            _fo_first="${_fo_url%/}/manifest.json" ;;
    esac

    if ! fetch_url "$_fo_first" "$_fo_body"; then
        echo "aerial-lock-fetch: $_fo_name: fetch failed: $_fo_first" >&2
        return 1
    fi

    _fo_kind="$(classify "$_fo_body")"
    case "$_fo_kind" in
        wrapper\ *)
            _fo_next="${_fo_kind#wrapper }"
            if ! fetch_url "$_fo_next" "$_fo_body.2"; then
                echo "aerial-lock-fetch: $_fo_name: fetch failed: $_fo_next" >&2
                return 1
            fi
            _fo_body="$_fo_body.2"
            _fo_kind="$(classify "$_fo_body")"
            ;;
    esac

    case "$_fo_kind" in
        tar)
            if ! tar -xOf "$_fo_body" entries.json > "$TMP/$_fo_name.entries" 2>/dev/null \
                    || [ ! -s "$TMP/$_fo_name.entries" ]; then
                echo "aerial-lock-fetch: $_fo_name: tar has no entries.json" >&2
                return 1
            fi
            ;;
        entries)
            cp -- "$_fo_body" "$TMP/$_fo_name.entries"
            ;;
        *)
            echo "aerial-lock-fetch: $_fo_name: unrecognized manifest shape" >&2
            return 1
            ;;
    esac

    if ! install_entries "$TMP/$_fo_name.entries" "$_fo_cache"; then
        echo "aerial-lock-fetch: $_fo_name: invalid entries.json — skipped" >&2
        return 1
    fi

    # Per asset: in-band heights first, then same-as-preferred, else next
    # up, else highest in-band — never above max. Nothing in-band → the
    # asset is skipped; zero in-band assets → the pack is skipped.
    python3 - "$TMP/$_fo_name.entries" "$LIMIT" "$_fo_min" "$_fo_max" "$PREFERRED" > "$TMP/$_fo_name.tsv" <<'PYEOF'
import json, sys

data = json.load(open(sys.argv[1]))
limit = int(sys.argv[2])
lo = int(sys.argv[3]) if sys.argv[3] else 0
hi = int(sys.argv[4]) if sys.argv[4] else 10**9
preferred = int(sys.argv[5]) if sys.argv[5] else None

# Same-height key order: H.264 first at 1080 (cheapest decode), SDR first
# at 2160 (the only SDR/HDR pair community packs ship).
KEYS = {1080: ["url-1080-H264", "url-1080-SDR", "url-1080-HDR"],
        2160: ["url-4K-SDR", "url-4K-HDR"]}

def pick(asset):
    cands = {}
    for h, keys in KEYS.items():
        if lo <= h <= hi:
            for k in keys:
                if asset.get(k):
                    cands[h] = asset[k]
                    break
    if not cands:
        return None
    if preferred in cands:
        return cands[preferred]
    if preferred is not None:
        higher = [h for h in cands if h > preferred]
        if higher:
            return cands[min(higher)]
    return cands[max(cands)]

assets = data.get("assets", [])
if limit > 0:
    assets = assets[:limit]
for a in assets:
    aid = a.get("id")
    url = pick(a)
    if aid and url:
        print(aid + "\t" + url)
PYEOF

    if [ ! -s "$TMP/$_fo_name.tsv" ]; then
        echo "aerial-lock-fetch: $_fo_name: no in-band URLs in manifest — pack skipped" >&2
        return 1
    fi

    mkdir -p -- "$_fo_cache/videos"
    TAB="$(printf '\t')"
    while IFS="$TAB" read -r id url; do
        [ -n "$id" ] || continue
        out="$_fo_cache/videos/$id.mp4"
        if [ -s "$out" ] && [ -f "$out.done" ]; then
            echo "aerial-lock-fetch: $_fo_name: have $id — skipped"
            continue
        fi
        echo "aerial-lock-fetch: $_fo_name: fetching $id"
        if fetch_url "$url" "$out" -C -; then
            touch -- "$out.done"
        else
            rm -f -- "$out.done"
            echo "aerial-lock-fetch: $_fo_name: clip $id failed — continuing" >&2
        fi
    done < "$TMP/$_fo_name.tsv"

    set -- "$_fo_cache/videos"/*.mp4
    [ -e "$1" ]
}

PREFERRED=""
[ -s "$TMP/preferred" ] && PREFERRED="$(cat "$TMP/preferred")"

ANY=1
while IFS="$(printf '\t')" read -r name _type url min max; do
    [ -n "$name" ] || continue
    if fetch_one "$name" "$url" "$min" "$max"; then
        ANY=0
    fi
done < "$TMP/sources.tsv"

if [ "$ANY" -eq 0 ]; then
    echo "aerial-lock-fetch: done — clips cached under $CACHE_BASE"
    exit 0
fi
echo "aerial-lock-fetch: no clips in any fetched cache" >&2
exit 1
