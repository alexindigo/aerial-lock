#!/bin/sh
# aerial-lock-fetch — download Apple Aerial clips into the local cache.
#
# The locker never hits the network; this opt-in command is the only
# network path. Playback unions the local videoDir with this cache.
#
# Cache layout ($XDG_CACHE_HOME/aerial-lock/apple, else ~/.cache/aerial-lock/apple):
#   entries.json     manifest sentinel — the locker only checks that it exists
#   videos/<id>.mp4  one file per asset id; existing clips are skipped
#
# Apple serves the manifest and clips from sylvan.apple.com under Apple's own
# CA chain (CN=Apple Root CA), which is not in Linux system trust stores. The
# root cert is pinned below; retrieved over public TLS from
# https://www.apple.com/appleca/AppleIncRootCertificate.cer
# sha256 B0:B1:73:0E:CB:C7:FF:45:05:14:2C:49:F1:29:5E:6E:DA:6B:CA:ED:7E:2C:68:C5:BE:91:B5:A1:10:01:F0:24
# valid 2006-04-25 .. 2035-02-09.

set -eu

MANIFEST_URL="https://sylvan.apple.com/Aerials/resources-16.tar"

usage() {
    cat >&2 <<'EOF'
usage: aerial-lock-fetch [--limit N] [--quality 1080]

Downloads the Apple Aerial manifest and 1080p H.264 clips into the cache.
  --limit N     fetch only the first N assets (for tests / a first run).
                Default: no limit.
  --quality     only 1080 is supported in v1 (1080p H.264).
  -h, --help    this text.

Exit: 0 if at least one clip is in the cache when done (already cached
counts); 1 if the manifest could not be fetched or no clips exist; 2 on
bad arguments.
EOF
}

LIMIT=0
QUALITY=1080
while [ $# -gt 0 ]; do
    case "$1" in
        --limit)
            [ $# -ge 2 ] || { usage; exit 2; }
            LIMIT="$2"
            case "$LIMIT" in
                ''|*[!0-9]*) echo "aerial-lock-fetch: --limit needs a number" >&2; usage; exit 2 ;;
            esac
            shift 2
            ;;
        --quality)
            [ $# -ge 2 ] || { usage; exit 2; }
            QUALITY="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage
            exit 2
            ;;
    esac
done

[ "$QUALITY" = "1080" ] || { echo "aerial-lock-fetch: only --quality 1080 is supported in v1" >&2; exit 2; }

if [ -n "${XDG_CACHE_HOME:-}" ]; then
    CACHE="$XDG_CACHE_HOME/aerial-lock/apple"
else
    CACHE="$HOME/.cache/aerial-lock/apple"
fi
VIDEOS="$CACHE/videos"
mkdir -p "$VIDEOS"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# Pinned Apple Root CA (see header).
cat > "$TMP/apple-root.pem" <<'EOF'
-----BEGIN CERTIFICATE-----
MIIEuzCCA6OgAwIBAgIBAjANBgkqhkiG9w0BAQUFADBiMQswCQYDVQQGEwJVUzET
MBEGA1UEChMKQXBwbGUgSW5jLjEmMCQGA1UECxMdQXBwbGUgQ2VydGlmaWNhdGlv
biBBdXRob3JpdHkxFjAUBgNVBAMTDUFwcGxlIFJvb3QgQ0EwHhcNMDYwNDI1MjE0
MDM2WhcNMzUwMjA5MjE0MDM2WjBiMQswCQYDVQQGEwJVUzETMBEGA1UEChMKQXBw
bGUgSW5jLjEmMCQGA1UECxMdQXBwbGUgQ2VydGlmaWNhdGlvbiBBdXRob3JpdHkx
