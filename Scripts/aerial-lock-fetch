#!/bin/sh
# aerial-lock-fetch — download remote Aerial sources into local caches.
#
# The locker never hits the network; this opt-in command is the only
# network path. It reads the same config the locker uses
# ($XDG_CONFIG_HOME/aerial-lock/config.json) and fetches every `apple` /
# `community` entry of its "sources" list. `folder` / `file` entries are
# local and ignored.
#
# Cache layout ($XDG_CACHE_HOME/aerial-lock/<safe-name>/):
#   entries.json     manifest sentinel — the locker only checks that it exists
#   videos/<id>.mp4  one file per asset id
#   <id>.mp4.done    completion marker — a clip without it is a partial and
#                    gets resumed (-C -), never treated as cached (d35)
#
# <safe-name>: the source's name with spaces as '-' and anything outside
# [A-Za-z0-9._-] stripped (same rule the locker's SourceCache applies).
#
# Clip height per asset: the source's resolution band (optional
# minResolution/maxResolution in config — 1080 or 2160, hard limits), then
# the global preferredResolution (same height in-band, else next up, never
# past max; d37). If the key is absent from the user config and a niri/
# Hyprland probe can see outputs, it is written there once (largest
# logical output height); a present key is never overwritten.
#
# Wire shapes handled (researched live, d35/d36):
#   - URL ending in .tar            → tarball containing entries.json (Apple)
#   - URL ending in .json           → a manifest: either a wrapper
#                                    ("manifestUrl" → follow once) or a bare
#                                    VideoManifest ("assets")
#   - anything else                 → pack base URL; fetch <url>/manifest.json
#                                    (wrapper) and follow its manifestUrl
#   - the followed body is either a tar or a bare VideoManifest JSON.
# Community 2020/2026 serve entries.json directly from manifestUrl.
#
# sylvan.apple.com serves under Apple's own root (absent from Linux trust
# stores): on a curl exit 60 (issuer untrusted) the request is retried once
# with the pinned Apple Root CA below — a fallback, not a blanket pin, so
# github.io / custom hosts keep normal system trust.
#   Pinned cert: https://www.apple.com/appleca/AppleIncRootCertificate.cer
#   sha256 B0:B1:73:0E:CB:C7:FF:45:05:14:2C:49:F1:29:5E:6E:DA:6B:CA:ED:7E:2C:68:C5:BE:91:B5:A1:10:01:F0:24
#   valid 2006-04-25 .. 2035-02-09.

set -eu

usage() {
    cat >&2 <<'EOF'
usage: aerial-lock-fetch [--limit N]

Fetches the apple/community sources from the aerial-lock config into the
local cache. Clip height is chosen per asset: the source's resolution
band ([minResolution, maxResolution]; 1080 or 2160, hard limits) first,
then the global preferredResolution (same height if in-band, else the
next height up, never past max). A pack with nothing in-band is warned
about and skipped.
  --limit N     fetch only the first N assets per source (tests / first
                run). Default: no limit.
  -h, --help    this text.

Exit: 0 if at least one clip exists in a fetched cache when done (already
cached counts); 1 if the config has no remote sources or none produced a
clip; 2 on bad arguments.
EOF
}

LIMIT=0
while [ $# -gt 0 ]; do
    case "$1" in
        --limit)
            [ $# -ge 2 ] || { usage; exit 2; }
            LIMIT="$2"
            case "$LIMIT" in
                ''|*[!0-9]*) echo "aerial-lock-fetch: --limit needs a number" >&2; usage; exit 2 ;;
            esac
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage
            exit 2
            ;;
    esac
done

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/aerial-lock/config.json"
CACHE_BASE="${XDG_CACHE_HOME:-$HOME/.cache}/aerial-lock"

TMP="$(mktemp -d)"
trap 'rm -rf -- "$TMP"' EXIT

# Pinned Apple Root CA (see header).
PEM="$TMP/apple-root.pem"
cat > "$PEM" <<'EOF'
-----BEGIN CERTIFICATE-----
MIIEuzCCA6OgAwIBAgIBAjANBgkqhkiG9w0BAQUFADBiMQswCQYDVQQGEwJVUzET
MBEGA1UEChMKQXBwbGUgSW5jLjEmMCQGA1UECxMdQXBwbGUgQ2VydGlmaWNhdGlv
biBBdXRob3JpdHkxFjAUBgNVBAMTDUFwcGxlIFJvb3QgQ0EwHhcNMDYwNDI1MjE0
