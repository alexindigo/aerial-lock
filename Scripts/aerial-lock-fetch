# fetch_url <url> <dest> [extra curl args...] — on curl exit 60 (issuer not
# trusted) retry once with the pinned Apple Root CA.
fetch_url() {
    _fu_url="$1"; _fu_dest="$2"; shift 2
    _fu_rc=0
    curl --fail -sS "$@" -o "$_fu_dest" "$_fu_url" || _fu_rc=$?
    if [ "$_fu_rc" -eq 60 ]; then
        echo "aerial-lock-fetch: system trust failed for $_fu_url — retrying with pinned Apple Root CA" >&2
        _fu_rc=0
        curl --fail -sS --cacert "$PEM" "$@" -o "$_fu_dest" "$_fu_url" || _fu_rc=$?
    fi
    return "$_fu_rc"
}

# Validated remote sources from the user config: "safe-name<TAB>type<TAB>url".
# Same per-field tolerance as the locker (bad entry → WARN naming the index,
# rest kept); name sanitize/dedupe rule matches SourceCache.qml.
if [ ! -f "$CONFIG" ]; then
    echo "aerial-lock-fetch: no config at $CONFIG — no remote sources" >&2
    exit 1
fi
python3 - "$CONFIG" > "$TMP/sources.tsv" <<'PYEOF'
import json, re, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception as e:
    sys.stderr.write(f"aerial-lock-fetch: cannot parse {sys.argv[1]}: {e}\n")
    sys.exit(3)
sources = data.get("sources", [])
if not isinstance(sources, list):
    sys.stderr.write("aerial-lock-fetch: config 'sources' is not a list\n")
    sys.exit(3)
seen = set()
for i, s in enumerate(sources):
    if not isinstance(s, dict) or not all(isinstance(s.get(k), str) and s.get(k) for k in ("type", "name", "source")):
        sys.stderr.write(f"aerial-lock-fetch: sources[{i}] needs type/name/source strings — skipped\n")
        continue
    if s["type"] not in ("apple", "community", "folder", "file"):
        sys.stderr.write(f"aerial-lock-fetch: sources[{i}].type {s['type']!r} unknown — skipped\n")
        continue
    if s["type"] in ("folder", "file"):
        continue
    safe = re.sub(r"[^A-Za-z0-9._-]", "", s["name"].replace(" ", "-"))
    if not safe:
        sys.stderr.write(f"aerial-lock-fetch: sources[{i}].name sanitizes to nothing — skipped\n")
        continue
    if safe in seen:
        sys.stderr.write(f"aerial-lock-fetch: duplicate source name {safe!r} — skipping later entry\n")
        continue
    seen.add(safe)
    print(safe + "\t" + s["type"] + "\t" + s["source"])
PYEOF

if [ ! -s "$TMP/sources.tsv" ]; then
    echo "aerial-lock-fetch: no remote sources in config" >&2
    exit 1
fi

# classify <file> → prints "entries" (bare VideoManifest), "wrapper <url>",
# or "unknown".
classify() {
    python3 - "$1" <<'PYEOF'
import json, sys
raw = open(sys.argv[1], "rb").read()
if raw[257:262] == b"ustar":
    print("tar"); sys.exit(0)
try:
    d = json.loads(raw)
except Exception:
    print("unknown"); sys.exit(0)
if isinstance(d, dict) and isinstance(d.get("assets"), list):
    print("entries")
elif isinstance(d, dict) and isinstance(d.get("manifestUrl"), str) and d["manifestUrl"]:
    print("wrapper " + d["manifestUrl"])
else:
    print("unknown")
PYEOF
}

# install_entries <src-file> <cache-dir> — validate + atomic replace.
install_entries() {
    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert isinstance(d.get("assets"), list)' "$1" 2>/dev/null || {
        echo "aerial-lock-fetch: entries.json is not a valid manifest" >&2
        return 1
    }
    mkdir -p "$2"
    cp "$1" "$2/entries.json.tmp"
    mv -f "$2/entries.json.tmp" "$2/entries.json"
}

# fetch_one <safe-name> <url> — resolve the manifest body (tar / wrapper /
# bare JSON), install the sentinel, download the 1080p clips. Returns 0 if
# the cache holds at least one clip when done.
fetch_one() {
    _fo_name="$1"; _fo_url="$2"
    _fo_cache="$CACHE_BASE/$_fo_name"
    _fo_body="$TMP/$_fo_name.body"

    case "$_fo_url" in
        *.tar|*.json) _fo_first="$_fo_url" ;;
        *)            _fo_first="${_fo_url%/}/manifest.json" ;;
    esac

    if ! fetch_url "$_fo_first" "$_fo_body"; then
        echo "aerial-lock-fetch: $_fo_name: fetch failed: $_fo_first" >&2
        return 1
    fi

    _fo_kind="$(classify "$_fo_body")"
    case "$_fo_kind" in
        wrapper\ *)
            _fo_next="${_fo_kind#wrapper }"
            if ! fetch_url "$_fo_next" "$_fo_body.2"; then
                echo "aerial-lock-fetch: $_fo_name: fetch failed: $_fo_next" >&2
                return 1
            fi
            _fo_body="$_fo_body.2"
            _fo_kind="$(classify "$_fo_body")"
            ;;
    esac

    case "$_fo_kind" in
        tar)
            if ! tar -xOf "$_fo_body" entries.json > "$TMP/$_fo_name.entries" 2>/dev/null \
                    || [ ! -s "$TMP/$_fo_name.entries" ]; then
                echo "aerial-lock-fetch: $_fo_name: tar has no entries.json" >&2
                return 1
            fi
            ;;
        entries)
            cp "$_fo_body" "$TMP/$_fo_name.entries"
            ;;
        *)
            echo "aerial-lock-fetch: $_fo_name: unrecognized manifest shape" >&2
            return 1
            ;;
    esac

    if ! install_entries "$TMP/$_fo_name.entries" "$_fo_cache"; then
        echo "aerial-lock-fetch: $_fo_name: invalid entries.json — skipped" >&2
        return 1
    fi

    # 1080p preference: H.264, then SDR, then HDR. No 1080 field → skip pack.
    python3 - "$TMP/$_fo_name.entries" "$LIMIT" > "$TMP/$_fo_name.tsv" <<'PYEOF'
import json, sys
data = json.load(open(sys.argv[1]))
limit = int(sys.argv[2])
assets = data.get("assets", [])
if limit > 0:
    assets = assets[:limit]
for a in assets:
    aid = a.get("id")
    url = a.get("url-1080-H264") or a.get("url-1080-SDR") or a.get("url-1080-HDR")
    if aid and url:
        print(aid + "\t" + url)
PYEOF

    if [ ! -s "$TMP/$_fo_name.tsv" ]; then
        echo "aerial-lock-fetch: $_fo_name: no 1080p URLs in manifest — pack skipped" >&2
        return 1
    fi

    mkdir -p "$_fo_cache/videos"
    TAB="$(printf '\t')"
    while IFS="$TAB" read -r id url; do
        [ -n "$id" ] || continue
        out="$_fo_cache/videos/$id.mp4"
        if [ -s "$out" ] && [ -f "$out.done" ]; then
            echo "aerial-lock-fetch: $_fo_name: have $id — skipped"
            continue
        fi
        echo "aerial-lock-fetch: $_fo_name: fetching $id"
        if fetch_url "$url" "$out" -C -; then
            touch "$out.done"
        else
            rm -f "$out.done"
            echo "aerial-lock-fetch: $_fo_name: clip $id failed — continuing" >&2
        fi
    done < "$TMP/$_fo_name.tsv"

    set -- "$_fo_cache/videos"/*.mp4
    [ -e "$1" ]
}

ANY=1
while IFS="$(printf '\t')" read -r name _type url; do
    [ -n "$name" ] || continue
    if fetch_one "$name" "$url"; then
        ANY=0
    fi
done < "$TMP/sources.tsv"

if [ "$ANY" -eq 0 ]; then
    echo "aerial-lock-fetch: done — clips cached under $CACHE_BASE"
    exit 0
fi
echo "aerial-lock-fetch: no clips in any fetched cache" >&2
exit 1
