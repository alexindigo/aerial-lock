// Nested niri sandbox for aerial-lock testing.
// Rendered by Scripts/dev/nested.sh (@REPO_ROOT@ / @TERMINAL@ are
// substituted at launch); do not run niri on this template directly.
//
// Mod is Alt when niri runs as a nested window (Super on a TTY), which
// keeps these binds from colliding with the host compositor's.

spawn-at-startup "@TERMINAL@"

binds {
    // Launch the locker from this repo.
    Mod+L { spawn "qs" "-p" "@REPO_ROOT@"; }

    // Kill switch — spawn is the only bind class niri allows to fire while
    // locked, so the escape kills the locker (releasing the lock) rather
    // than quitting the compositor directly.
    Mod+Shift+Escape allow-when-locked=true { spawn "pkill" "-f" "qs -p.*aerial-lock"; }

    // Quit the nested compositor (when unlocked).
    Mod+Shift+Q { quit skip-confirmation=true; }
}

environment {
    QT_QPA_PLATFORM "wayland"
}
