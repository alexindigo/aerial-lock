#!/usr/bin/env bash
set -euo pipefail
shell_dir=""
plugin_root=""
while (($#)); do
    case "$1" in
        --shell-dir) shell_dir=$2; shift 2 ;;
        --plugin-root) plugin_root=$2; shift 2 ;;
        *) printf 'aerial-lock-run: unknown argument %s\n' "$1" >&2; exit 71 ;;
    esac
done
if [[ ! -d "$shell_dir" || ! -d "$plugin_root" || ! -f "$plugin_root/generic/libAerialLockConnectionGuard.so" ]]; then
    printf 'aerial-lock-run: shell/plugin paths are unavailable\n' >&2
    exit 71
fi
unset AERIAL_LOCK_CONNECTION_GUARD_PID QT_WAYLAND_RECONNECT
export AERIAL_LOCK_CONNECTION_GUARD_OWNER_PID=$$
export QT_QPA_PLATFORM=wayland QSG_RHI_BACKEND=opengl QS_DISABLE_CRASH_HANDLER=1
export QT_PLUGIN_PATH="$plugin_root${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
export QT_QPA_GENERIC_PLUGINS=AerialLockConnectionGuard
exec qs -p "$shell_dir"
