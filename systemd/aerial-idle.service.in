[Unit]
Description=aerial-lock idle and session-lock daemon
Documentation=https://github.com/alexindigo/aerial-lock
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
ExecStart=@BINDIR@/aerial-idle
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
